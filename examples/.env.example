# Copy to `.env`. Single quotes keep the `$` signs of the hash away from Compose.

# Public origin of Wealthfolio: scheme, host, and port if it is not the default. No path, no trailing slash.
WFSYNC_ORIGIN=https://wealthfolio.example.com

# Comma-separated: trading212, bitvavo, bitget, monefit, goandgrow, debitum. Empty means no source runs.
WFSYNC_SOURCES=monefit,debitum

# Optional: Yahoo tickers for coins whose symbol collides with another listing, as SYMBOL=YAHOO,SYMBOL=YAHOO.
WFSYNC_YAHOO_ALIASES=

# Time zone of the nightly run and of the page.
TZ=Etc/UTC

# openssl rand -base64 32
WF_SECRET_KEY=

# printf '%s' 'your-password' | argon2 "$(openssl rand -base64 16)" -id -e
WF_AUTH_PASSWORD_HASH=''
